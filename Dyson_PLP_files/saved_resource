      <div data-analytics-action-title="What does an air purifier do?" class="faq-q-and-a__accordion" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
         <div class="accordion__section faq-q-and-a__accordion-section">
               <a href="#" class="accordion__heading" data-aria-controls="b954bc2f33f644b2a75249a554707143" data-analytics-action-name="accordion~heading">
                  <span class="faq-q-and-a__accordion-heading-text faq" itemprop="name">What does an air purifier do?</span>
                  <svg class="shape shape--medium shape--chevron faq-q-and-a__accordion-heading--chevron" data-svg-href="/etc.clientlibs/dyson/clientlibs/clientlib-main/resources/icons/icons.sprite.svg#chevron" aria-hidden="true" data-analytics-action-name="accordion~shape">
